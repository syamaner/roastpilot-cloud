+        # Both are legal in Snowflake's unquoted-identifier grammar; the
+        # check enforces that grammar, not a narrower house style.
+        assert_dev_ci_grants.assert_sql_identifier_safe("_ROLE$1", "SNOWFLAKE_DEV_ROLE")
